# Copy to .env.local and fill in. Both values are public-by-design browser
# credentials — they ship in the built bundle. Security comes from the
# Authorized JavaScript origins (client ID) and the HTTP referrer + API
# restrictions (API key), not from keeping these hidden.

# OAuth 2.0 Client ID — APIs & Services > Credentials > OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=

# API key, restricted to the Google Picker API
VITE_GOOGLE_API_KEY=
